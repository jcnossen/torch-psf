{
  "name": "torch-psf-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "torch-psf in the browser: bead z-stack -> vectorial PSF fit with WebGPU",
  "scripts": {
    "dev": "vite",
    "dev:psfgrab": "vite --config vite.psfgrab.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:psfgrab": "tsc --noEmit && vite build --config vite.psfgrab.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "python test/run_tests.py",
    "test:psfgrab": "esbuild test/psfgrab_node.ts --bundle --platform=node --format=esm --log-level=warning --outfile=test/out/psfgrab_node.mjs && node test/out/psfgrab_node.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/three": "0.160.0",
    "@webgpu/types": "0.1.74",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  },
  "dependencies": {
    "h5wasm": "0.10.3",
    "three": "0.160.1"
  }
}
